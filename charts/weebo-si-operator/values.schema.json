{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {},
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "extraLabels": {}
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer"
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "type": "integer"
            },
            "maxSurge": {
              "type": "integer"
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": "integer"
            }
          }
        },
        "resources": {},
        "podAntiAffinity": {
          "type": "boolean"
        },
        "extraArgs": {},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer"
            },
            "targetPort": {
              "type": "integer"
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer"
        },
        "leaderElection": {
          "type": "boolean"
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer"
            }
          }
        },
        "resources": {},
        "podAntiAffinity": {
          "type": "boolean"
        },
        "extraArgs": {}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kubeApiserver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "description": "The kube-apiserver addresses as CIDRs (ipBlock). Required when enabled unless a narrowing selector is given.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ports": {
              "description": "Egress ports on the apiserver endpoints (after the kubernetes Service DNAT).",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "namespaceSelector": {
              "$ref": "#/definitions/labelSelector"
            },
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "$ref": "#/definitions/labelSelector"
            },
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaceSelector": {
              "$ref": "#/definitions/labelSelector"
            },
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            }
          }
        },
        "extraIngress": {
          "description": "NetworkPolicyIngressRule list, rendered as given.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEgress": {
          "description": "NetworkPolicyEgressRule list, rendered as given.",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "certificates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "cert-manager",
            "openshift",
            "none"
          ]
        },
        "secretName": {
          "type": "string"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "namespaceExclusionLabel": {
      "type": "string"
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "kubearmorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "registryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Fail",
            "Ignore"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "argoNamespace": {
          "type": "string"
        }
      }
    },
    "endpointAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Fail",
            "Ignore"
          ]
        },
        "dialect": {
          "type": "string",
          "enum": [
            "Traefik",
            "HaproxyIngress",
            "OpenShiftRoute",
            "Custom"
          ]
        },
        "namespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "networkProfiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cilium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            }
          }
        }
      }
    },
    "policyGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Fail",
            "Ignore"
          ]
        }
      }
    },
    "imagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podWebhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failurePolicy": {
              "type": "string",
              "enum": [
                "Fail",
                "Ignore"
              ]
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "nodeSelector": {},
    "tolerations": {},
    "global": {},
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "definitions": {
    "labelSelector": {
      "description": "A Kubernetes LabelSelector. `{}` selects everything.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string",
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
