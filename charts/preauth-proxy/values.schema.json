{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "preauth-proxy chart values",
  "description": "See charts/preauth-proxy/values.yaml and docs/bricks/preauth-proxy.md.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "labelSelector": {
      "description": "A Kubernetes LabelSelector. `{}` selects everything.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "properties": {
    "global": {
      "description": "Injected by Helm when this chart is a subchart.",
      "type": "object"
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "containerPort": {
      "description": "Must equal the port of config.listen (checked at render).",
      "$ref": "#/definitions/port"
    },
    "config": {
      "description": "The whole preauth-proxy config.yaml body, as a YAML string or a map.",
      "type": ["string", "object"]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {
          "description": "Name of a Secret you created. Required: the chart renders no Secret of its own.",
          "type": "string",
          "minLength": 1
        },
        "userKey": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "description": "Empty disables the rule.",
              "type": ["integer", "string"]
            },
            "from": {
              "description": "NetworkPolicyPeer list, rendered as given.",
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
